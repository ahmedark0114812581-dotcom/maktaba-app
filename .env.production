# متغيرات البيئة للنشر على Render
# انسخ الملف ده واسميه .env وحط القيم الحقيقية
# ⚠️ ما ترفعش الملف ده على GitHub

# رابط التطبيق العام (من النفق أو Render)
EXPO_PUBLIC_API_URL=https://seller-crown-debian-compact.trycloudflare.com

# رابط الإعلان (من Monetag أو Adsterra)
EXPO_PUBLIC_AD_URL=

# B2 Storage
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=maktaba-videos
B2_ENDPOINT=s3.us-west-004.backblazeb2.com

# كلمة سر لوحة التحكم (اتولد تلقائياً من Render)
ADMIN_PASSWORD=
